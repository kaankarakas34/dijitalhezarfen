{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/otomasyon",
      "destination": "/otomasyon/index.html"
    },
    {
      "source": "/otomasyon/gizlilik",
      "destination": "/otomasyon/gizlilik.html"
    },
    {
      "source": "/otomasyon/kullanim",
      "destination": "/otomasyon/kullanim.html"
    },
    {
      "source": "/yayinlar/:slug",
      "destination": "/yayinlar/:slug/index.html"
    },
    {
      "source": "/:slug(kapso-whatsapp-chatbot-codex-claude-code-kurulum|google-ai-mode-reklamlari-arama-ekonomisi|microsoft-openai-10-milyar-dolar-gelir|sap-model-routing-ai-maliyet-optimizasyonu|nvidia-hugging-face-satin-alma-rekabet|upwind-400-milyon-dolar-bulut-guvenligi|guidewire-hyperexponential-sigorta-yapay-zeka|rebuild-venture-studio-ileri-uretim|jio-platforms-halka-arz-platform-ekonomisi|ai-veri-merkezleri-nukleer-enerji|samsung-hbm-yapay-zeka-bellek|unitree-robotik-buyume-karlilik|nvidia-nemotron-sesli-yapay-zeka|harmonic-aristotle-formal-verification|gsk-onkoloji-klinik-arastirma-stratejisi|lush-sosyal-medya-reklamsiz-marka-stratejisi)",
      "destination": "/yayinlar/:slug/index.html"
    },
    {
      "source": "/((?!otomasyon/|assets/|articles/|images/|favicon.svg|icons.svg|robots.txt|sitemap.xml|yayinlar/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/articles/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
